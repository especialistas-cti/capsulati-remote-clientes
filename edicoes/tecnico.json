{
  "capsulati": {
    "edicao": "tecnico",
    "nome_exibicao": "Capsula TI Remote",
    "descricao": "Acesso remoto Capsula TI - tecnico",
    "bundle_id": "br.com.capsulati.remote",
    "empresa": "Capsula TI"
  },
  "custom": {
    "app-name": "CapsulaTI-Remote",
    "conn-type": "outgoing",
    "override-settings": {
